<?xml version="1.0" encoding="utf-8"?>
<!-- Dark palette: the values-night override of values/colors.xml.
     Same role names (the MD3 scheme roles plus the app-specific
     ones below them); only the values change. On the dark side the
     surface ramp inverts: surface is the darkest ground and each
     container step gets lighter (the MD3 dark-scheme principle).
     Kotlin reads these through Colors.load() exactly like the
     light values, so no code change comes with this file. -->
<resources>
    <color name="primary">#A8C7FA</color>
    <color name="primary_container">#004A77</color>
    <color name="on_surface">#E3E3E3</color>
    <color name="on_surface_variant">#C4C7C5</color>
    <color name="surface">#131314</color>
    <color name="surface_container_low">#1B1C1E</color>
    <color name="surface_container">#1F2022</color>
    <color name="surface_container_high">#282A2D</color>
    <color name="outline">#8E918F</color>
    <color name="outline_variant">#444746</color>
    <color name="error">#F2B8B5</color>
    <color name="scrim">#99000000</color>
    <!-- App-specific roles below the MD3 scheme roles. -->
    <color name="icon">#E3E3E3</color>
    <color name="warn">#E8A33D</color>
    <color name="card_active">#26334D</color>
    <color name="ic_launcher_bg">#D9C1FE</color>
</resources>
