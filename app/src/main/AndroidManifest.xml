<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Library manifest contributions are merged by AGP from the
         AARs (docs/dependencies.md): androidx.core supplies the
         DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION signature
         permission pair and the appComponentFactory,
         play-services-basement the gms.version meta-data,
         play-services-base GoogleApiActivity, and the ML Kit AARs
         MlKitComponentDiscoveryService with their four component
         registrars (their MlKitInitProvider is removed below).
         What the merger must never bring in is removed explicitly
         below. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No app code uses this directly, but Chromium's WebView
         needs it for its network-change notifier: without it,
         navigator.onLine and online/offline events in pages stop
         reflecting reality. It is a normal
         (auto-granted) permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Declared so pages can be granted camera/microphone
         (getUserMedia) after the runtime prompt and the in-app
         per-site confirmation. The app itself never uses
         either outside a page's granted request. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- No app code uses this directly, but Chromium's media stack
         requires the embedder to hold it (together with RECORD_AUDIO)
         for WebRTC audio capture: without it, Chromium finds no
         usable recording device and a granted getUserMedia audio
         request fails with NotReadableError (confirmed on
         device). It is a normal (auto-granted)
         permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Package visibility for ONE resolution (SEN-357): the
         file picker pins itself to the system's own
         ACTION_OPEN_DOCUMENT handler (SEC-170), which requires
         resolving that intent. Without this declaration,
         Android 11+ visibility filtering can hide the system
         handler from the resolution. Nothing else is queried. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <!-- The resolved intent always carries a type
                 (a specific MIME type or the any-type
                 wildcard); the visibility match for a typed
                 intent needs the data element to match it
                 (SEN-363). -->
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- extractNativeLibs is false: the bundled .so files are
         stored uncompressed and page-aligned, so the platform
         maps them from the APK instead of extracting a second
         copy at install time. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- Deliberately NOT merged from the datatransport AARs:
             TransportBackendDiscovery (and its CCT backend
             meta-data), JobInfoSchedulerService and
             AlarmManagerSchedulerBroadcastReceiver. Without
             backend discovery and the scheduler components,
             ML Kit's diagnostic events have no upload path and
             stay on the device; the classes remain linked
             because ML Kit code references them directly.
             See docs/dependencies.md. The shipped component set
             as a whole is pinned by app/manifest-components.txt
             and asserted after every build. -->
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />

        <!-- Deliberately NOT merged from the ML Kit AARs:
             MlKitInitProvider, the SDK's startup initializer.
             It ran at every process start although on-device
             translation is the only ML Kit use in this app;
             PageTranslator now initializes the SDK explicitly
             at its first use (PER-3). The component discovery
             service stays: the registrars it feeds are how
             the translate and language-id clients find their
             implementations. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
